{
  "expo": {
    "name": "Xprinta Asistente",
    "slug": "xprinta-asistente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "asistentexprinta.xprintapro.com",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Xprinta Asistente necesita reconocimiento de voz para transcribir tus notas e ideas de diseño y producción.",
        "NSMicrophoneUsageDescription": "Xprinta Asistente necesita acceso al micrófono para interactuar por voz con el asistente."
      },
      "appleTeamId": "855K4HU668"
    },
    "android": {
      "package": "com.xprintapro.asistentexprinta",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio"
    ]
  }
}